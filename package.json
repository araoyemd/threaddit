{
  "name": "threadit",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "build:preview": "vite build --mode preview && node scripts/make-artifact.mjs",
    "test:bots": "esbuild tests/bots.test.ts --bundle --platform=node --format=esm --outfile=.tmp/bots.test.mjs --log-level=warning && node .tmp/bots.test.mjs",
    "test:account": "esbuild tests/account.test.ts --bundle --platform=node --format=esm --outfile=.tmp/account.test.mjs --log-level=warning && node .tmp/account.test.mjs",
    "test:site": "esbuild tests/site-rules.test.ts --bundle --platform=node --format=esm --outfile=.tmp/site-rules.test.mjs --log-level=warning && node .tmp/site-rules.test.mjs",
    "test": "npm run -s test:site && npm run -s test:bots && npm run -s test:account"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.4",
    "lucide-react": "^0.487.0",
    "motion": "^12.23.24",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.2",
    "sonner": "^2.0.3",
    "tw-animate-css": "^1.3.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.12",
    "@types/react": "^18.3.20",
    "@types/react-dom": "^18.3.6",
    "@vitejs/plugin-react": "^4.7.0",
    "tailwindcss": "^4.1.12",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-singlefile": "^2.2.0"
  }
}
